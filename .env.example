# =============================================================================
# LibreRegistration - Configuration
# =============================================================================
# Copiez ce fichier en .env et adaptez les valeurs.
# Copy this file to .env and adjust the values.

# -- Serveur / Server --------------------------------------------------------

PORT=8080
BASE_URL=http://localhost:8080

# Timezone used to parse and display event dates (IANA name).
APP_TIMEZONE=Europe/Paris

# -- Base de donnees / Database -----------------------------------------------
# SQLite (defaut) : seul DATABASE_PATH est utilise.
# PostgreSQL      : utilisez docker-compose.postgresql.yml et renseignez
#                   POSTGRES_PASSWORD ci-dessous. DATABASE_PATH est ignore.
#
# SQLite (default): only DATABASE_PATH is used.
# PostgreSQL:       use docker-compose.postgresql.yml and set
#                   POSTGRES_PASSWORD below. DATABASE_PATH is ignored.

DATABASE_DRIVER=sqlite
DATABASE_PATH=/data/libreregistration.db

# Mot de passe PostgreSQL (utilise par docker-compose.postgresql.yml)
# PostgreSQL password (used by docker-compose.postgresql.yml)
# POSTGRES_PASSWORD=change-me-strong-password

# -- Securite / Security ------------------------------------------------------
# Changez imperativement ces valeurs en production (32 caracteres minimum).
# You MUST change these in production (minimum 32 characters).

SESSION_SECRET=change-me-to-a-random-32-char-string
CSRF_KEY=change-me-to-another-32-char-str

# -- Compte administrateur initial / Initial admin account --------------------
# Utilise uniquement au premier demarrage pour creer le compte admin.
# Only used on first run to create the admin account.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# -- E-mail (SMTP) -----------------------------------------------------------
# Facultatif. Active les notifications : confirmation d'inscription,
# notification aux organisateurs, verification d'e-mail.
#
# Optional. Enables notifications: registration confirmation,
# organizer notification, email verification.

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=Example  # optional display name for the From header
# SMTP_INSECURE=true  # skip TLS certificate verification (self-signed certs)
