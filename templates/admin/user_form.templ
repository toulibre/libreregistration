package admin

import (
	"context"
	"fmt"
	"github.com/toulibre/libreregistration/internal/i18n"
	"github.com/toulibre/libreregistration/internal/models"
	"github.com/toulibre/libreregistration/templates/layouts"
)

templ UserForm(user *models.User, isEdit bool, siteName string, accentColor string, displayName string, csrfField string, errorMsg string) {
	@layouts.AdminShell(userFormTitle(ctx, isEdit), siteName, accentColor, displayName) {
		<h1 class="text-2xl font-bold mb-6">{ userFormTitle(ctx, isEdit) }</h1>
		if errorMsg != "" {
			<div class="bg-red-50 text-red-700 p-3 rounded mb-4 text-sm">{ errorMsg }</div>
		}
		if isEdit {
			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/admin/users/%s", user.ID)) } class="bg-white rounded-lg shadow-sm p-6 space-y-4 max-w-md">
				@templ.Raw(csrfField)
				<input type="hidden" name="_method" value="PUT"/>
				@userFormFields(user, isEdit)
			</form>
		} else {
			<form method="POST" action="/admin/users" class="bg-white rounded-lg shadow-sm p-6 space-y-4 max-w-md">
				@templ.Raw(csrfField)
				@userFormFields(user, isEdit)
			</form>
		}
	}
}

templ userFormFields(user *models.User, isEdit bool) {
	<div>
		<label for="username" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "user_form.label.login") }</label>
		<input type="text" id="username" name="username" value={ user.Username } required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
	</div>
	<div>
		<label for="name" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "user_form.label.name") }</label>
		<input type="text" id="name" name="name" value={ user.Name } class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
	</div>
	<div>
		<label for="password" class="block text-sm font-medium text-gray-700 mb-1">
			if isEdit {
				{ i18n.T(ctx, "user_form.label.password_edit") }
			} else {
				{ i18n.T(ctx, "user_form.label.password") }
			}
		</label>
		if isEdit {
			<input type="password" id="password" name="password" minlength="8" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
		} else {
			<input type="password" id="password" name="password" required minlength="8" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
		}
	</div>
	<div>
		<label for="role" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "user_form.label.role") }</label>
		<select id="role" name="role" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent">
			<option value="manager" selected?={ user.Role == "manager" || user.Role == "" }>{ i18n.T(ctx, "user_form.role.manager") }</option>
			<option value="admin" selected?={ user.Role == "admin" }>{ i18n.T(ctx, "user_form.role.admin") }</option>
		</select>
	</div>
	<div class="flex gap-3 pt-4">
		if isEdit {
			<button type="submit" class="bg-accent text-white px-6 py-2 rounded-md hover:bg-accent-dark transition-colors">{ i18n.T(ctx, "user_form.button.save") }</button>
		} else {
			<button type="submit" class="bg-accent text-white px-6 py-2 rounded-md hover:bg-accent-dark transition-colors">{ i18n.T(ctx, "user_form.button.create") }</button>
		}
		<a href="/admin/users" class="px-6 py-2 text-gray-600 hover:text-gray-800">{ i18n.T(ctx, "user_form.button.cancel") }</a>
	</div>
}

func userFormTitle(ctx context.Context, isEdit bool) string {
	if isEdit {
		return i18n.T(ctx, "user_form.title.edit")
	}
	return i18n.T(ctx, "user_form.title")
}
