package public

import (
	"github.com/toulibre/libreregistration/internal/i18n"
	"github.com/toulibre/libreregistration/internal/models"
	"github.com/toulibre/libreregistration/templates/layouts"
)

templ AccountDashboard(siteName string, accentColor string, displayName string, registrations []models.Registration) {
	@layouts.PublicShell(i18n.T(ctx, "account.title"), siteName, accentColor) {
		<div class="flex justify-between items-center mb-6">
			<h1 class="text-2xl font-bold">{ i18n.T(ctx, "account.heading") }</h1>
			<div class="flex gap-3 text-sm">
				<a href="/account/profile" class="text-accent hover:text-accent-dark">{ i18n.T(ctx, "account.nav.profile") }</a>
				<a href="/account/password" class="text-accent hover:text-accent-dark">{ i18n.T(ctx, "account.nav.password") }</a>
				<form method="POST" action="/logout" class="inline">
					<button type="submit" class="text-gray-500 hover:text-gray-700">{ i18n.T(ctx, "nav.logout") }</button>
				</form>
			</div>
		</div>
		<h2 class="text-lg font-semibold mb-4">{ i18n.T(ctx, "account.registrations") }</h2>
		if len(registrations) == 0 {
			<p class="text-gray-500">{ i18n.T(ctx, "account.no_registrations") }</p>
		} else {
			<div class="bg-white rounded-lg shadow-sm overflow-x-auto">
				<table class="w-full">
					<thead class="bg-gray-50">
						<tr>
							<th class="text-left px-4 py-3 text-sm font-medium text-gray-500">{ i18n.T(ctx, "account.col.event") }</th>
							<th class="text-left px-4 py-3 text-sm font-medium text-gray-500">{ i18n.T(ctx, "account.col.date") }</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-100">
						for _, reg := range registrations {
							<tr>
								<td class="px-4 py-3">
									<a href={ templ.SafeURL("/event/" + reg.EventSlug) } class="text-accent hover:text-accent-dark font-medium">{ reg.EventTitle }</a>
								</td>
								<td class="px-4 py-3 text-sm text-gray-500">{ i18n.FormatDate(ctx, reg.RegisteredAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<div class="mt-12 pt-6 border-t border-gray-200">
			<a href="/account/delete" class="text-sm text-red-500 hover:text-red-700">{ i18n.T(ctx, "account.delete_link") }</a>
		</div>
	}
}

templ AccountProfile(user *models.User, siteName string, accentColor string, csrfField string, errorMsg string, flash string) {
	@layouts.PublicShell(i18n.T(ctx, "account.profile.title"), siteName, accentColor) {
		<div class="max-w-md mx-auto">
			<h1 class="text-2xl font-bold mb-6">{ i18n.T(ctx, "account.profile.heading") }</h1>
			if flash != "" {
				<div data-flash class="bg-green-50 text-green-700 p-3 rounded mb-4 text-sm">{ flash }</div>
			}
			if errorMsg != "" {
				<div class="bg-red-50 text-red-700 p-3 rounded mb-4 text-sm">{ errorMsg }</div>
			}
			<form method="POST" action="/account/profile" enctype="multipart/form-data" class="bg-white rounded-lg shadow-sm p-6 space-y-4">
				@templ.Raw(csrfField)
				<input type="hidden" name="_method" value="PUT"/>
				<div>
					<label for="name" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "user_form.label.name") }</label>
					<input type="text" id="name" name="name" value={ user.Name } class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
				</div>
				<div>
					<label for="email" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "user_form.label.email") }</label>
					<input type="email" id="email" name="email" value={ user.Email } class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
				</div>
				<div>
					<label for="avatar" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "user_form.label.avatar") }</label>
					if user.AvatarPath != "" {
						<div class="mb-2 flex items-center gap-3">
							<img src={ "/uploads/" + user.AvatarPath } class="w-16 h-16 rounded-full object-cover" alt={ user.DisplayName() }/>
							<label class="flex items-center gap-1 text-sm text-red-500 cursor-pointer">
								<input type="checkbox" name="remove_avatar" value="true"/>
								{ i18n.T(ctx, "user_form.remove_avatar") }
							</label>
						</div>
					}
					<input type="file" id="avatar" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200"/>
				</div>
				<div class="flex gap-3 pt-4">
					<button type="submit" class="bg-accent text-white px-6 py-2 rounded-md hover:bg-accent-dark transition-colors">{ i18n.T(ctx, "user_form.button.save") }</button>
					<a href="/account" class="px-6 py-2 text-gray-600 hover:text-gray-800">{ i18n.T(ctx, "user_form.button.cancel") }</a>
				</div>
			</form>
		</div>
	}
}

templ AccountPassword(siteName string, accentColor string, displayName string, csrfField string, errorMsg string, flash string) {
	@layouts.PublicShell(i18n.T(ctx, "password.title"), siteName, accentColor) {
		<div class="max-w-md mx-auto">
			<h1 class="text-2xl font-bold mb-6">{ i18n.T(ctx, "password.heading") }</h1>
			if flash != "" {
				<div data-flash class="bg-green-50 text-green-700 p-3 rounded mb-4 text-sm">{ flash }</div>
			}
			if errorMsg != "" {
				<div class="bg-red-50 text-red-700 p-3 rounded mb-4 text-sm">{ errorMsg }</div>
			}
			<form method="POST" action="/account/password" class="bg-white rounded-lg shadow-sm p-6 space-y-4">
				@templ.Raw(csrfField)
				<input type="hidden" name="_method" value="PUT"/>
				<div>
					<label for="current_password" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "password.label.current") }</label>
					<input type="password" id="current_password" name="current_password" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
				</div>
				<div>
					<label for="new_password" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "password.label.new") }</label>
					<input type="password" id="new_password" name="new_password" required minlength="8" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
				</div>
				<div>
					<label for="confirm_password" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "password.label.confirm") }</label>
					<input type="password" id="confirm_password" name="confirm_password" required minlength="8" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
				</div>
				<div class="flex gap-3 pt-4">
					<button type="submit" class="bg-accent text-white px-6 py-2 rounded-md hover:bg-accent-dark transition-colors">{ i18n.T(ctx, "password.button.save") }</button>
					<a href="/account" class="px-6 py-2 text-gray-600 hover:text-gray-800">{ i18n.T(ctx, "user_form.button.cancel") }</a>
				</div>
			</form>
		</div>
	}
}

templ AccountDelete(siteName string, accentColor string, displayName string, csrfField string) {
	@layouts.PublicShell(i18n.T(ctx, "account.delete.title"), siteName, accentColor) {
		<div class="max-w-md mx-auto">
			<h1 class="text-2xl font-bold mb-6 text-red-600">{ i18n.T(ctx, "account.delete.heading") }</h1>
			<div class="bg-red-50 text-red-700 p-4 rounded mb-6 text-sm">
				{ i18n.T(ctx, "account.delete.warning") }
			</div>
			<form method="POST" action="/account/delete" class="space-y-4">
				@templ.Raw(csrfField)
				<div class="flex gap-3">
					<button type="submit" class="bg-red-600 text-white px-6 py-2 rounded-md hover:bg-red-700 transition-colors">{ i18n.T(ctx, "account.delete.confirm") }</button>
					<a href="/account" class="px-6 py-2 text-gray-600 hover:text-gray-800">{ i18n.T(ctx, "user_form.button.cancel") }</a>
				</div>
			</form>
		</div>
	}
}
