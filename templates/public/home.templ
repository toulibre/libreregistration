package public

import (
	"github.com/toulibre/libreregistration/internal/i18n"
	"github.com/toulibre/libreregistration/internal/models"
	"github.com/toulibre/libreregistration/templates/layouts"
)

templ Home(events []models.Event, pag models.Pagination, showPast bool, siteName string, accentColor string) {
	@layouts.PublicShell(i18n.T(ctx, "home.title"), siteName, accentColor) {
		<div class="flex justify-between items-center mb-6">
			<h1 class="text-3xl font-bold">{ i18n.T(ctx, "home.heading") }</h1>
			<a href={ templ.SafeURL(icalFeedURL(showPast)) } class="inline-flex items-center gap-1 text-sm text-accent hover:text-accent-dark">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
				{ i18n.T(ctx, "home.subscribe_ical") }
			</a>
		</div>
		<div class="flex gap-4 mb-6 border-b border-gray-200">
			if !showPast {
				<span class="pb-2 border-b-2 border-accent text-accent font-medium text-sm">{ i18n.T(ctx, "home.tab.upcoming") }</span>
			} else {
				<a href="/" class="pb-2 text-sm text-gray-500 hover:text-gray-700">{ i18n.T(ctx, "home.tab.upcoming") }</a>
			}
			if showPast {
				<span class="pb-2 border-b-2 border-accent text-accent font-medium text-sm">{ i18n.T(ctx, "home.tab.past") }</span>
			} else {
				<a href="/?show=past" class="pb-2 text-sm text-gray-500 hover:text-gray-700">{ i18n.T(ctx, "home.tab.past") }</a>
			}
		</div>
		if len(events) == 0 {
			if showPast {
				<p class="text-gray-500">{ i18n.T(ctx, "home.no_past_events") }</p>
			} else {
				<p class="text-gray-500">{ i18n.T(ctx, "home.no_events") }</p>
			}
		} else {
			<div class="space-y-4">
				for _, event := range events {
					<a href={ templ.SafeURL("/event/" + event.Slug) } class="block bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition-shadow">
						<h2 class="text-xl font-semibold text-accent">{ event.Title }</h2>
						<div class="mt-2 text-sm text-gray-500 space-x-4">
							<span>📅 { i18n.FormatDateTime(ctx, event.EventDate) }</span>
							if event.Location != "" {
								<span>📍 { event.Location }</span>
							}
						</div>
					</a>
				}
			</div>
			<div class="flex justify-between items-center mt-6">
				@layouts.PageSizeSelector(pag.PageSize, homeBaseURL(showPast))
				@layouts.Pagination(pag, homeBaseURL(showPast))
			</div>
		}
	}
}

func homeBaseURL(showPast bool) string {
	if showPast {
		return "/?show=past"
	}
	return "/"
}

func icalFeedURL(showPast bool) string {
	if showPast {
		return "/events/past.ics"
	}
	return "/events.ics"
}
