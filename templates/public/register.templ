package public

import (
	"github.com/toulibre/libreregistration/internal/i18n"
	"github.com/toulibre/libreregistration/internal/models"
	"github.com/toulibre/libreregistration/templates/layouts"
)

templ RegisterForm(siteName string, accentColor string, csrfField string, errorMsg string, user *models.User) {
	@layouts.PublicShell(i18n.T(ctx, "register.title"), siteName, accentColor) {
		<div class="max-w-md mx-auto">
			<h1 class="text-2xl font-bold mb-6">{ i18n.T(ctx, "register.heading") }</h1>
			if errorMsg != "" {
				<div class="bg-red-50 text-red-700 p-3 rounded mb-4 text-sm">{ errorMsg }</div>
			}
			<form method="POST" action="/register" class="bg-white rounded-lg shadow-sm p-6 space-y-4">
				@templ.Raw(csrfField)
				<div>
					<label for="username" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "register.label.username") }</label>
					<input type="text" id="username" name="username" value={ user.Username } required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
				</div>
				<div>
					<label for="name" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "register.label.name") }</label>
					<input type="text" id="name" name="name" value={ user.Name } class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
				</div>
				<div>
					<label for="email" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "register.label.email") }</label>
					<input type="email" id="email" name="email" value={ user.Email } class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
				</div>
				<div>
					<label for="password" class="block text-sm font-medium text-gray-700 mb-1">{ i18n.T(ctx, "register.label.password") }</label>
					<input type="password" id="password" name="password" required minlength="8" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-accent"/>
				</div>
				<button type="submit" class="w-full bg-accent text-white py-2 px-4 rounded-md hover:bg-accent-dark transition-colors">{ i18n.T(ctx, "register.button") }</button>
			</form>
			<p class="mt-4 text-center text-sm text-gray-500">
				{ i18n.T(ctx, "register.already_have_account") }
				<a href="/admin/login" class="text-accent hover:text-accent-dark">{ i18n.T(ctx, "register.login_link") }</a>
			</p>
		</div>
	}
}
