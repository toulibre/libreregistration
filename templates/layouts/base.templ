package layouts

import "github.com/toulibre/libreregistration/internal/i18n"

type OGMeta struct {
	Title       string
	Description string
	Image       string
	URL         string
	Type        string
}

templ Base(title string, siteName string, accentColor string, og *OGMeta) {
	<!DOCTYPE html>
	<html lang={ i18n.HTMLLang(ctx) } style={ accentColorStyle(accentColor) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — { siteName }</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			if og != nil {
				<meta property="og:title" content={ og.Title }/>
				<meta property="og:site_name" content={ siteName }/>
				if og.Type != "" {
					<meta property="og:type" content={ og.Type }/>
				} else {
					<meta property="og:type" content="website"/>
				}
				if og.Description != "" {
					<meta property="og:description" content={ og.Description }/>
					<meta name="description" content={ og.Description }/>
				}
				if og.Image != "" {
					<meta property="og:image" content={ og.Image }/>
				}
				if og.URL != "" {
					<meta property="og:url" content={ og.URL }/>
				}
			}
		</head>
		<body class="min-h-screen bg-gray-50 text-gray-900">
			{ children... }
			@preventDoubleSubmit()
			@tableFilterScript()
		</body>
	</html>
}

func accentColorStyle(color string) string {
	if color == "" {
		return ""
	}
	return "--accent-color:" + color
}

templ PublicShell(title string, siteName string, accentColor string) {
	@PublicShellOG(title, siteName, accentColor, nil) {
		{ children... }
	}
}

templ PublicShellOG(title string, siteName string, accentColor string, og *OGMeta) {
	@Base(title, siteName, accentColor, og) {
		<header class="bg-white shadow-sm">
			<div class="max-w-4xl mx-auto px-4 py-4 flex justify-between items-center">
				<a href="/" class="text-xl font-bold text-accent hover:text-accent-dark">{ siteName }</a>
				<div class="flex items-center gap-3 text-sm">
					if IsLoggedIn(ctx) {
						if IsUserRole(ctx) {
							<a href="/account" class="text-accent hover:text-accent-dark">{ CtxDisplayName(ctx) }</a>
						} else {
							<a href="/admin/" class="text-accent hover:text-accent-dark">{ CtxDisplayName(ctx) }</a>
						}
						<form method="POST" action="/logout" class="inline">
							<button type="submit" class="text-gray-500 hover:text-gray-700">{ i18n.T(ctx, "nav.logout") }</button>
						</form>
					} else {
						if AllowSelfRegistration(ctx) {
							<a href="/register" class="text-accent hover:text-accent-dark font-medium">{ i18n.T(ctx, "register.button.short") }</a>
						}
						<a href="/admin/login" class="text-gray-500 hover:text-gray-700">{ i18n.T(ctx, "login.button") }</a>
					}
					@langSwitcher()
				</div>
			</div>
		</header>
		<main class="max-w-4xl mx-auto px-4 py-8">
			{ children... }
		</main>
		@FlashAutoDismiss()
		<footer class="mt-16 border-t border-gray-200 py-6 text-center text-sm text-gray-500">
			<p>{ i18n.T(ctx, "footer.powered_by") } <a href="https://github.com/toulibre/libreregistration" class="underline">LibreRegistration</a> · <a href="/admin/" class="hover:text-gray-700">{ i18n.T(ctx, "footer.admin") }</a></p>
		</footer>
	}
}

templ Logo(size string) {
	<svg xmlns="http://www.w3.org/2000/svg" width={ size } height={ size } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
		<line x1="16" y1="2" x2="16" y2="6"></line>
		<line x1="8" y1="2" x2="8" y2="6"></line>
		<line x1="3" y1="10" x2="21" y2="10"></line>
		<path d="M9 16l2 2 4-4"></path>
	</svg>
}

templ AdminShell(title string, siteName string, accentColor string, username string) {
	@Base(title, siteName, accentColor, nil) {
		<div class="flex min-h-screen">
			<aside class="w-64 bg-gray-900 text-gray-100 p-4 space-y-2">
				<a href="/admin/" class="flex items-center gap-2 text-lg font-bold mb-6 text-white">
					@Logo("24")
					{ siteName }
				</a>
				@adminNavLink("/admin/", i18n.T(ctx, "nav.dashboard"), NavIsActive(ctx, "/admin/"))
				@adminNavLink("/admin/events", i18n.T(ctx, "nav.events"), NavIsActive(ctx, "/admin/events"))
				@adminNavLink("/admin/users", i18n.T(ctx, "nav.users"), NavIsActive(ctx, "/admin/users"))
				@adminNavLink("/admin/settings", i18n.T(ctx, "nav.settings"), NavIsActive(ctx, "/admin/settings"))
				<div class="mt-auto pt-8 border-t border-gray-700 text-sm text-gray-400">
					<p class="mb-2">{ username }</p>
					<a href="/admin/password" class="text-gray-400 hover:text-white underline">{ i18n.T(ctx, "nav.password") }</a>
					<form method="POST" action="/logout" class="mt-1">
						<button type="submit" class="text-gray-400 hover:text-white underline">{ i18n.T(ctx, "nav.logout") }</button>
					</form>
					<div class="mt-2">
						@langSwitcher()
					</div>
				</div>
			</aside>
			<div class="flex-1">
				<main class="p-8">
					{ children... }
				</main>
			</div>
			@FlashAutoDismiss()
		</div>
	}
}

templ adminNavLink(href string, label string, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } class="block px-3 py-2 rounded bg-gray-700 text-white font-medium" aria-current="page">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="block px-3 py-2 rounded hover:bg-gray-700">{ label }</a>
	}
}

templ FlashAutoDismiss() {
	<script>
	(function() {
		document.querySelectorAll('[data-flash]').forEach(function(el) {
			setTimeout(function() {
				el.style.transition = 'opacity 0.5s';
				el.style.opacity = '0';
				setTimeout(function() { el.remove(); }, 500);
			}, 5000);
		});
	})();
	</script>
}

templ langSwitcher() {
	if i18n.Locale(ctx) == "fr" {
		<a href="?lang=en" class="text-sm text-gray-400 hover:text-white">{ i18n.T(ctx, "lang.switch") }</a>
	} else {
		<a href="?lang=fr" class="text-sm text-gray-400 hover:text-white">{ i18n.T(ctx, "lang.switch") }</a>
	}
}

templ TableFilter(tableID string) {
	<div class="mb-4">
		<input
			type="text"
			data-filter-target={ tableID }
			placeholder={ i18n.T(ctx, "filter.placeholder") }
			class="w-full max-w-xs px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-accent"
		/>
	</div>
}

templ tableFilterScript() {
	<script>
	document.addEventListener('input', function(e) {
		var target = e.target.getAttribute('data-filter-target');
		if (!target) return;
		var table = document.getElementById(target);
		if (!table) return;
		var q = e.target.value.toLowerCase();
		var rows = table.querySelectorAll('tbody tr');
		var visible = 0;
		rows.forEach(function(row) {
			var text = row.textContent.toLowerCase();
			var match = !q || text.indexOf(q) !== -1;
			row.style.display = match ? '' : 'none';
			if (match) visible++;
		});
		var empty = table.parentElement.querySelector('[data-filter-empty]');
		if (empty) empty.style.display = (q && visible === 0) ? '' : 'none';
	});
	</script>
}

templ preventDoubleSubmit() {
	<script>
	document.addEventListener('submit', function(e) {
		var form = e.target;
		if (form.dataset.submitted) { e.preventDefault(); return; }
		form.dataset.submitted = 'true';
		var btn = form.querySelector('button[type="submit"]');
		if (btn) { btn.disabled = true; btn.style.opacity = '0.6'; }
		setTimeout(function() {
			delete form.dataset.submitted;
			if (btn) { btn.disabled = false; btn.style.opacity = ''; }
		}, 5000);
	});
	</script>
}
